{
  "manifest_version": 3,
  "name": "GitBrief",
  "description": "Insert an AI summary card into GitHub repository pages.",
  "version": "0.1.10",
  "icons": {
    "16": "src/assets/icons/gitbrief-16.png",
    "32": "src/assets/icons/gitbrief-32.png",
    "48": "src/assets/icons/gitbrief-48.png",
    "128": "src/assets/icons/gitbrief-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*", "https://raw.githubusercontent.com/*", "<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html",
  "action": {
    "default_title": "GitBrief",
    "default_icon": {
      "16": "src/assets/icons/gitbrief-16.png",
      "32": "src/assets/icons/gitbrief-32.png",
      "48": "src/assets/icons/gitbrief-48.png",
      "128": "src/assets/icons/gitbrief-128.png"
    },
    "default_popup": "src/popup.html"
  }
}
